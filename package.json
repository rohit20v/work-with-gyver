{
  "name": "work-with-gyver",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "cross-env NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "cross-env NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "remix": "^3.0.0-rc.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "typescript": "latest"
  }
}
